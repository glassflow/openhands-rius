# Your model. Claude comes through with full model, token and cost data.
LLM_MODEL=anthropic/claude-haiku-4-5-20251001
LLM_API_KEY=sk-ant-...

# Rius. The key needs the "Send telemetry" (ingest) scope.
# Keep %20 between Bearer and the key: the value is URL-encoded.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://ingest.eu.console.rius-glassflow.com/v1/traces
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Bearer%20ri_...

# Optional: the agent name Rius shows. Defaults to openhands-demo.
AGENT_NAME=openhands-demo

# Leave every LMNR_* variable unset. A Laminar key overrides the OTEL settings.
